// Function Prototypes
float getDistanceCM();
int getGsmSignalStrength();
void sendSMS(const char* phone, const char* message);
void updateDisplay(int levelPct, bool floatTrig, bool dangerState, int csq);
void setupWebServer();

void setup() {
  Serial.begin(115200);
  gsmSerial.begin(9600, SERIAL_8N1, GSM_RX, GSM_TX);

  pinMode(TRIG_PIN, OUTPUT);
  pinMode(ECHO_PIN, INPUT);
  pinMode(FLOAT_PIN, INPUT_PULLUP);
  pinMode(BUZZER_PIN, OUTPUT);
  digitalWrite(BUZZER_PIN, LOW);

  // 1. Load Saved Settings from ESP32 Flash EEPROM (Namespace: "dam_cfg")
  preferences.begin("dam_cfg", false);
  targetPhone = preferences.getString("phone", "+919975617490");
  damDepthCm = preferences.getInt("depth", 100);
  thresholdLevel = preferences.getInt("thresh", 80);

  Serial.println("--- EEPROM Loaded Settings ---");
  Serial.println("Target Phone: " + targetPhone);
  Serial.printf("Dam Depth: %d cm | Threshold: %d%%\n", damDepthCm, thresholdLevel);

  // 2. Initialize 16x2 LCD
  lcd.init();
  lcd.backlight();
  lcd.setCursor(0, 0);
  lcd.print("CONNECTING WIFI");
  lcd.setCursor(0, 1);
  lcd.print(WIFI_SSID);

  // 3. Connect to Mobile Hotspot
  WiFi.mode(WIFI_STA);
  WiFi.begin(WIFI_SSID, WIFI_PASS);
  unsigned long wifiStart = millis();
-   while (WiFi.status() != WL_CONNECTED && millis()wifiStart < 
15000) {
    delay(500);
    Serial.print(".");
  }

  lcd.clear();
  if (WiFi.status() == WL_CONNECTED) {
    Serial.println("\nConnected! Dashboard IP: " + WiFi.localIP().toString());
    lcd.setCursor(0, 0);
    lcd.print("GUI IP ADDRESS:");
    lcd.setCursor(0, 1);
    lcd.print(WiFi.localIP().toString());
    delay(4000); // Show IP on LCD for 4 seconds so you can open it on your phone
  } else {
    Serial.println("\nHotspot timeout. Running offline monitoring.");
    lcd.setCursor(0, 0);
    lcd.print("WIFI TIMEOUT!");
    lcd.setCursor(0, 1);
    lcd.print("Offline Mode ON");
    delay(2000);
  }

  // 4. Start Web Dashboard Server
  setupWebServer();

  // 5. Initialize GSM Module
  lcd.clear();
  lcd.setCursor(0, 0);
  lcd.print("DAM MONITOR INIT");
  lcd.setCursor(0, 1);
  lcd.print("Wait for GSM...");

  delay(2500);
  gsmSerial.println("AT");
  delay(500);
  gsmSerial.println("AT+CMGF=1"); // Set SMS to Text Mode
  delay(500);

  gsmSignal = getGsmSignalStrength();
  lcd.clear();
}

void loop() {
  // Handle incoming web dashboard requests
  server.handleClient();

  unsigned long currentMillis = millis();

  // 1. Poll GSM Signal Strength every 10 seconds
  if (currentMillis - lastGsmPoll >= 10000) {
    lastGsmPoll = currentMillis;
    gsmSignal = getGsmSignalStrength();
  }

  // 2. Read Sensors & Evaluate Dam State every 500ms
  if (currentMillis - lastCheckTime >= 500) {
    lastCheckTime = currentMillis;

    currentDistanceCm = getDistanceCM();

    // Convert distance from top sensor into water fill percentage
    float waterHeight = damDepthCm - currentDistanceCm;
    if (waterHeight < 0) waterHeight = 0;
    if (waterHeight > damDepthCm) waterHeight = damDepthCm;
-     currentLevelPct = (int)((waterHeight / (float)damDepthCm)
100.0);

    // Read Float Sensor (LOW = water crossed float switch)
    floatTriggered = (digitalRead(FLOAT_PIN) == LOW);

    // Evaluate Overall Alert Condition (Threshold OR Float Switch)
    isCritical = (currentLevelPct >= thresholdLevel) || floatTriggered;

    // SMS Logic: Send SMS ONLY ONCE strictly when Float Sensor is triggered
    if (floatTriggered) {
      if (!smsSent) {
        lcd.clear();
        lcd.setCursor(0, 0);
        lcd.print("FLOAT CROSSED!");
        lcd.setCursor(0, 1);
        lcd.print("Sending SMS...");

        char alertMsg[140];
        snprintf(alertMsg, sizeof(alertMsg),
                 "DAM ALERT: Water crossed the Float Sensor! Current Level: %d%% (Depth: %.1fcm). Immediate action required.",
                 currentLevelPct, damDepthCm - currentDistanceCm);

        sendSMS(targetPhone.c_str(), alertMsg);
        smsSent = true; // Lock SMS so it only sends once
        lcd.clear();
      }
    } else {
      // Reset SMS lock when water drops back below the float switch
      smsSent = false;
    }

    // Turn off buzzer if neither float nor threshold is critical
    if (!isCritical) {
      digitalWrite(BUZZER_PIN, LOW);
      buzzerState = false;
    }

    updateDisplay(currentLevelPct, floatTriggered, isCritical, gsmSignal);
  }

  // 3. Non-blocking Buzzer Pulsing during Critical Alert
  if (isCritical) {
    if (currentMillis - lastBuzzerToggle >= 250) {
      lastBuzzerToggle = currentMillis;
      buzzerState = !buzzerState;
      digitalWrite(BUZZER_PIN, buzzerState ? HIGH : LOW);
    }
  }
}

// --- Web Server API Endpoints ---
void setupWebServer() {
  // Serve Main GUI Page
  server.on("/", HTTP_GET, []() {
    server.send_P(200, "text/html", INDEX_HTML);
  });

  // Serve Live JSON Telemetry
  server.on("/api/status", HTTP_GET, []() {
    int sigPct = (gsmSignal > 0 && gsmSignal <= 31) ? map(gsmSignal, 0, 31, 0, 100) : 0;
    String json = "{";
    json += "\"level\":" + String(currentLevelPct) + ",";
    json += "\"distance\":" + String(currentDistanceCm, 1) + ",";
    json += "\"floatTrig\":" + String(floatTriggered ? "true" : "false") + ",";
    json += "\"critical\":" + String(isCritical ? "true" : "false") + ",";
    json += "\"smsSent\":" + String(smsSent ? "true" : "false") + ",";
    json += "\"csq\":" + String(gsmSignal) + ",";
    json += "\"gsmPct\":" + String(sigPct) + ",";
    json += "\"phone\":\"" + targetPhone + "\",";
    json += "\"depth\":" + String(damDepthCm) + ",";
    json += "\"threshold\":" + String(thresholdLevel);
    json += "}";
    server.send(200, "application/json", json);
  });

  // Save Updated Settings to ESP32 Flash EEPROM
  server.on("/api/settings", HTTP_POST, []() {
    if (server.hasArg("phone")) {
      targetPhone = server.arg("phone");
      preferences.putString("phone", targetPhone);
    }
    if (server.hasArg("depth")) {
      int d = server.arg("depth").toInt();
      if (d >= 10 && d <= 500) {
        damDepthCm = d;
        preferences.putInt("depth", damDepthCm);
      }
    }
    if (server.hasArg("threshold")) {
      int t = server.arg("threshold").toInt();
      if (t >= 5 && t <= 100) {
        thresholdLevel = t;
        preferences.putInt("thresh", thresholdLevel);
      }
    }
    Serial.println("EEPROM Updated -> Phone: " + targetPhone + " | Depth: " + String(damDepthCm) + "cm | Thresh: " + String(thresholdLevel) + "%");
    server.send(200, "application/json", "{\"status\":\"saved\"}");
  });

  server.begin();
}

// --- Ultrasonic Sensor Read ---
float getDistanceCM() {
  digitalWrite(TRIG_PIN, LOW);
  delayMicroseconds(2);
  digitalWrite(TRIG_PIN, HIGH);
  delayMicroseconds(10);
  digitalWrite(TRIG_PIN, LOW);

  long duration = pulseIn(ECHO_PIN, HIGH, 30000);
  if (duration == 0) {
    return damDepthCm;
  }
  return (duration * 0.0343) / 2.0;
}

// --- GSM Signal Parser (AT+CSQ) ---
int getGsmSignalStrength() {
  while (gsmSerial.available()) gsmSerial.read();

  gsmSerial.println("AT+CSQ");
  unsigned long start = millis();
  String response = "";

-   while (millis()start < 
1000) {
    while (gsmSerial.available()) {
      char c = gsmSerial.read();
      response += c;
    }
  }

  int idx = response.indexOf("+CSQ:");
  if (idx != -1) {
    int commaIdx = response.indexOf(",", idx);
    if (commaIdx != -1) {
      String rssiStr = response.substring(idx + 5, commaIdx);
      rssiStr.trim();
      int rssi = rssiStr.toInt();
      if (rssi == 99) return 0;
      return rssi;
    }
  }
  return 0;
}

// --- GSM SMS Transmission ---
void sendSMS(const char* phone, const char* message) {
  gsmSerial.println("AT+CMGF=1");
  delay(500);
  gsmSerial.print("AT+CMGS=\"");
  gsmSerial.print(phone);
  gsmSerial.println("\"");
  delay(1000);
  gsmSerial.print(message);
  delay(200);
  gsmSerial.write(26); // ASCII CTRL+Z
  delay(3000);
  Serial.print("Alert SMS Dispatched to: ");
  Serial.println(phone);
}

// --- 16x2 LCD Formatter ---
void updateDisplay(int levelPct, bool floatTrig, bool dangerState, int csq) {
  int sigPct = (csq > 0 && csq <= 31) ? map(csq, 0, 31, 0, 100) : 0;

  char row0[17];
  snprintf(row0, sizeof(row0), "Lvl:%3d%% Sig:%2d%%", levelPct, sigPct);
  lcd.setCursor(0, 0);
  lcd.print(row0);

  char row1[17];
  snprintf(row1, sizeof(row1), "Flt:%s St:%s",
           floatTrig ? "HI " : "OK ",
           dangerState ? "ALRT!" : "SAFE ");
  lcd.setCursor(0, 1);
  lcd.print(row1);
} 
